{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwhog-hue/rhs-exchange/rhs-exchange-v3.schema.json",
  "title": "rhs-exchange v3 – Austauschformat der RH-App-Familie",
  "type": "object",
  "required": ["rhsFormat", "schemaVersion", "packageId", "createdAt", "source", "records"],
  "properties": {
    "rhsFormat": { "const": "rhs-exchange" },
    "schemaVersion": { "const": 3 },
    "packageType": { "enum": ["team", "training", "einsatz", "pruefung", "bundle"] },
    "packageId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "required": ["app"], "properties": { "app": { "type": "string" }, "appVersion": { "type": "string" }, "instanceId": { "type": "string" }, "geraet": { "type": "string" } } },
    "personen": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "hunde": { "type": "array", "items": { "$ref": "#/$defs/hund" } },
    "teams": { "type": "array", "items": { "$ref": "#/$defs/team" } },
    "records": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/teamRecord" }, { "$ref": "#/$defs/entryRecord" }, { "$ref": "#/$defs/anyRecord" }] } },
    "pruefsumme": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "kuerzel": { "type": "string", "maxLength": 4, "description": "Initialen, nie ein voller Name" },
    "skala": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "punkt": { "type": "object", "required": ["lat", "lon"], "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "zeit": { "type": ["string", "null"] }, "hoehe": { "type": ["number", "null"] } } },
    "track": { "type": "array", "items": { "$ref": "#/$defs/punkt" } },
    "person": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "rolle": { "type": "array", "items": { "type": "string" } }, "organisation": { "type": "string" }, "gruppe": { "type": "string" } } },
    "hund": { "type": "object", "required": ["id", "rufname"], "properties": { "id": { "type": "string" }, "rufname": { "type": "string" }, "geburtsdatum": { "type": ["string", "null"] }, "rasse": { "type": "string" }, "sparten": { "type": "array", "items": { "type": "string" } } }, "not": { "required": ["chipnummer"] } },
    "team": { "type": "object", "required": ["id", "personId", "hundId", "sparte"], "properties": { "id": { "type": "string" }, "personId": { "type": "string" }, "hundId": { "type": "string" }, "sparte": { "type": "string" }, "status": { "enum": ["in_ausbildung", "geprueft", "einsatzfaehig", "ruhend"] }, "anzeigeart": { "type": "string" }, "pruefungen": { "type": "array" } } },
    "fieldMeta": { "type": "object", "description": "Revisionsmarken wie in v2: je Feld {revision, updatedAt, sourceApp, sourceInstanceId} oder für den ganzen Record" },
    "teamRecord": { "type": "object", "required": ["type", "id", "data"], "properties": { "type": { "const": "team" }, "id": { "type": "string" }, "data": { "type": "object", "properties": { "handler": { "type": "string" }, "dogName": { "type": "string" }, "dogBirthDate": { "type": "string" }, "dogBreed": { "type": "string" }, "disciplines": { "type": ["array", "string"] }, "indicationType": { "type": "string" } } }, "fieldMeta": { "$ref": "#/$defs/fieldMeta" } } },
    "versteckperson": { "type": "object", "required": ["kuerzel"], "not": { "required": ["name"] }, "properties": { "kuerzel": { "$ref": "#/$defs/kuerzel" }, "rolle": { "type": "string" }, "geschlecht": { "type": "string" }, "alterCa": { "type": ["integer", "null"] }, "erfahrung": { "type": "string" }, "bekanntFuerHund": { "type": ["boolean", "string"] }, "verhaltenImVersteck": { "type": "string" }, "sicherungDurchHF": { "type": "string" }, "position": { "type": ["object", "null"] }, "positionen": { "type": "object", "properties": { "hfVermutung": {}, "hundTatsaechlich": {}, "vpTatsaechlich": {} } }, "gefunden": { "type": "boolean" }, "anzeige": { "type": "object", "properties": { "art": { "type": "string" }, "qualitaet": { "$ref": "#/$defs/skala" }, "pruefungsberechtigt": { "type": "boolean" } } }, "zeitBisFundMin": { "type": ["number", "null"] }, "latenzAuffindenBisAnzeigeSek": { "type": ["number", "null"] }, "haltevermoegenSek": { "type": ["number", "null"] }, "fehlverhalten": { "type": "string" } } },
    "bewertung": { "type": "object", "properties": { "ergebnis": { "enum": ["erfolgreich", "teilweise", "nicht_erfolgreich", "abgebrochen", "offen"] }, "schwierigkeit": { "$ref": "#/$defs/skala" }, "hundeleistung": { "$ref": "#/$defs/skala" }, "fuehrerleistung": { "$ref": "#/$defs/skala" }, "selbststaendigkeit": { "$ref": "#/$defs/skala" }, "zusammenarbeit": { "$ref": "#/$defs/skala" }, "deltaZurVoreinheit": { "type": ["number", "null"] }, "zusatzskalen": { "type": "array", "items": { "type": "object", "required": ["schluessel", "wert"], "properties": { "schluessel": { "type": "string" }, "wert": { "$ref": "#/$defs/skala" }, "beschriftung": { "type": "string" } } } }, "steigerungsstufe": { "type": "string" }, "naechsterSchritt": { "type": "string" }, "trainerbeobachtung": { "type": "string" }, "freitext": { "type": "string" } } },
    "entryData": { "type": "object", "required": ["typ", "sparte", "beginn"], "properties": {
      "teamId": { "type": "string" },
      "typ": { "enum": ["training", "pruefung", "einsatz", "vorfuehrung", "sonstiges"] },
      "sparte": { "enum": ["flaeche", "truemmer", "mantrailing", "gehorsam", "anzeigeverhalten", "gewandtheit", "physio", "alltag", "alltagstricks", "bindung", "modul11", "leiche", "wasser", "lawine", "begleithund", "igp", "agility", "trickdog", "sonstiges"] },
      "beginn": { "type": "string", "format": "date-time" }, "ende": { "type": ["string", "null"] },
      "ort": { "type": "object", "properties": { "name": { "type": "string" }, "lat": { "type": ["number", "null"] }, "lon": { "type": ["number", "null"] }, "gelaendeart": { "type": "string" }, "vorlageId": { "type": "string" } }, "not": { "required": ["heimatpunkt"] } },
      "wetter": { "type": "object" },
      "ausbilderKuerzel": { "$ref": "#/$defs/kuerzel" },
      "helfer": { "type": "array", "items": { "type": "object", "required": ["kuerzel"], "not": { "required": ["name"] }, "properties": { "kuerzel": { "$ref": "#/$defs/kuerzel" }, "rolle": { "type": "string" } } } },
      "ziel": { "type": "string" },
      "nutzlast": { "type": "object", "description": "spartenspezifisch; Tracks als $defs/track, Versteckpersonen als $defs/versteckperson; unbekannte Felder erlaubt", "properties": { "trackHund": { "$ref": "#/$defs/track" }, "trackFuehrer": { "$ref": "#/$defs/track" }, "trackSpurleger": { "$ref": "#/$defs/track" }, "versteckpersonen": { "type": "array", "items": { "$ref": "#/$defs/versteckperson" } }, "gpsEreignisse": { "type": "array" } } },
      "bewertung": { "$ref": "#/$defs/bewertung" },
      "hundZustand": { "type": "object", "properties": { "vorher": { "type": "string" }, "nachher": { "type": "string" }, "auffaelligkeiten": { "type": "string" } } },
      "notizen": { "type": "string" },
      "anhaenge": { "type": "array", "items": { "type": "object", "required": ["id", "art"], "properties": { "id": { "type": "string" }, "art": { "enum": ["track", "gebiet", "foto", "skizze", "dokument", "meldung"] }, "format": { "type": "string" }, "daten": {}, "aufnahmeort": {}, "notiz": { "type": "string" } } } },
      "kmHinRueck": { "type": ["number", "null"] },
      "quelle": { "type": "object", "properties": { "app": { "type": "string" }, "appVersion": { "type": "string" }, "schemaVersion": { "type": "integer" }, "importiertAm": { "type": ["string", "null"] }, "brueckenFormat": { "type": "string" } } },
      "aenderungslog": { "type": "array" },
      "roh": { "description": "Originaldaten der Quell-App, unverändert durchgereicht" }
    } },
    "entryRecord": { "type": "object", "required": ["type", "id", "data"], "properties": { "type": { "const": "entry" }, "id": { "type": "string" }, "data": { "$ref": "#/$defs/entryData" }, "fieldMeta": { "$ref": "#/$defs/fieldMeta" } } },
    "anyRecord": { "type": "object", "required": ["type", "id"], "properties": { "type": { "type": "string", "not": { "enum": ["team", "entry"] } }, "id": { "type": "string" } }, "description": "Reserviert für künftige Record-Typen (z. B. einsatz, pruefung); Leser reichen sie durch" }
  }
}
